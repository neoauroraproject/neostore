generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  workspace_owner
  workspace_admin
  operator
  customer
}

enum PlatformOrderStatus {
  PendingPayment
  Paid
  Processing
  Completed
  Delivered
  Cancelled
  Refunded
  Disputed
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REFUNDED
}

enum DeliveryMode {
  instant
  manual
}

enum LedgerEntryType {
  Deposit
  Purchase
  Refund
  Commission
  Adjustment
  Settlement
  Withdrawal
}

enum ExtensionStatus {
  installed
  enabled
  disabled
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  name         String?
  role         Role     @default(customer)
  telegramId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  store       StoreProfile?
  categories  Category[]
  blueprints  FulfillmentBlueprint[]
  products    Product[]
  customers   Customer[]
  orders      Order[]
  entitlements Entitlement[]
  inventoryPools InventoryPool[]
  extensions  WorkspaceExtension[]
  ledgerAccounts LedgerAccount[]
}

model WorkspaceMember {
  id          String @id @default(uuid())
  workspaceId String
  userId      String
  role        Role
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model StoreProfile {
  id                       String   @id @default(uuid())
  workspaceId              String   @unique
  title                    String
  slug                     String   @unique
  description              String?
  enabled                  Boolean  @default(true)
  defaultCurrency          String   @default("USD")
  paymentConfig            Json     @default("{}")
  autoDeliverEnabled        Boolean  @default(false)
  autoDeliverDelayMinutes   Int      @default(15)
  nextOrderNumber          Int      @default(1000)
  telegramBotEnabled       Boolean  @default(false)
  telegramBotTokenEnc      String?
  telegramBotUsername      String?
  telegramWebhookSecret    String?
  telegramWelcomeText      String?
  telegramAdminChatId      String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]
}

model FulfillmentBlueprint {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  description    String?
  providerType   String
  providerConfig Json     @default("{}")
  renewalPolicy  Json     @default("{}")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products       Product[]
}

model Product {
  id            String       @id @default(uuid())
  workspaceId   String
  categoryId    String
  blueprintId   String
  name          String
  description   String?
  type          String       @default("Digital")
  deliveryMode  DeliveryMode @default(instant)
  priceUsd      Float        @default(0)
  priceToman    Float?
  quotaUnits    BigInt       @default(0)
  durationDays  Int          @default(30)
  status        String       @default("active")
  badge         String?
  sortOrder     Int          @default(0)
  featured      Boolean      @default(false)
  visible       Boolean      @default(true)
  renewable     Boolean      @default(true)
  stockUnlimited Boolean     @default(true)
  stockCount    Int          @default(0)
  typeFields    Json         @default("{}")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category      Category     @relation(fields: [categoryId], references: [id])
  blueprint     FulfillmentBlueprint @relation(fields: [blueprintId], references: [id])
  orders        Order[]
}

model Customer {
  id                 String    @id @default(uuid())
  workspaceId        String
  token              String    @unique
  name               String?
  email              String?
  telegram           String?
  telegramUserId     String?
  telegramUsername   String?
  whatsapp           String?
  status             String    @default("active")
  notes              String?
  metadata           Json      @default("{}")
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions           CustomerSession[]
  orders             Order[]
  notifications      CustomerNotification[]
  entitlements       Entitlement[]

  @@unique([workspaceId, telegramUserId])
}

model CustomerSession {
  id         String    @id @default(uuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id         String    @id @default(uuid())
  customerId String
  type       String
  title      String
  message    String
  payload    Json      @default("{}")
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String              @id @default(uuid())
  workspaceId         String
  storeId             String
  productId           String
  customerId          String
  trackingCode        String              @unique
  configName          String
  amount              Float
  currency            String              @default("USD")
  status              PlatformOrderStatus @default(PendingPayment)
  rejectReason        String?
  provisionError      String?
  notes               String?
  entitlementId       String?
  isRenewal           Boolean             @default(false)
  renewEntitlementId  String?
  autoDeliverAt        DateTime?
  autoDelivered        Boolean             @default(false)
  pendingReview       Boolean             @default(false)
  renewSnapshot       Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  customer            Customer            @relation(fields: [customerId], references: [id])
  payment             Payment?
  timeline            OrderTimelineEvent[]
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String        @unique
  method       String
  status       PaymentStatus @default(PENDING)
  amount       Float
  currency     String        @default("USD")
  receiptText  String?
  receiptImage String?
  providerRef  String?
  metadata     Json          @default("{}")
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderTimelineEvent {
  id        String   @id @default(uuid())
  orderId   String
  status    String
  message   String
  actor     String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Entitlement {
  id           String    @id @default(uuid())
  workspaceId  String
  customerId   String?
  productId    String?
  orderId      String?
  blueprintId  String?
  label        String
  externalRef  String?
  accessKey    String?
  accessUrl    String?
  enable       Boolean   @default(true)
  quotaTotal   BigInt    @default(0)
  quotaUsed    BigInt    @default(0)
  expiresAt    DateTime?
  payload      Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id])
}

model InventoryPool {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       InventoryItem[]
}

model InventoryItem {
  id        String   @id @default(uuid())
  poolId    String
  code      String
  used      Boolean  @default(false)
  usedAt    DateTime?
  orderId   String?
  createdAt DateTime @default(now())
  pool      InventoryPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, code])
}

model LedgerAccount {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String?
  customerId  String?
  kind        String
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]
}

model LedgerEntry {
  id        String          @id @default(uuid())
  accountId String
  type      LedgerEntryType
  amount    Float
  currency  String          @default("USD")
  refType   String?
  refId     String?
  meta      Json            @default("{}")
  createdAt DateTime        @default(now())
  account   LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model InstalledExtension {
  id           String          @id @default(uuid())
  extensionId  String          @unique
  name         String
  version      String
  type         String
  status       ExtensionStatus @default(installed)
  manifest     Json
  sourceRepo   String?
  permissions  Json            @default("[]")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspaces   WorkspaceExtension[]
}

model WorkspaceExtension {
  id                    String @id @default(uuid())
  workspaceId           String
  installedExtensionId  String
  enabled               Boolean @default(true)
  settings              Json    @default("{}")
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  extension             InstalledExtension @relation(fields: [installedExtensionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, installedExtensionId])
}

model PlatformSettings {
  id    String @id @default("default")
  value Json   @default("{}")
}
