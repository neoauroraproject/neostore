# NeoStore environment (local / docker)
NODE_ENV=production
PORT=4100

POSTGRES_USER=neostore
POSTGRES_PASSWORD=neostore
POSTGRES_DB=neostore
DATABASE_URL=postgresql://neostore:neostore@postgres:5432/neostore
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-in-production
PUBLIC_BASE_URL=http://localhost
TELEGRAM_WEBHOOK_BASE_URL=http://localhost
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage

# Set by installer
DOMAIN=
TLS_SCHEME=http
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
STORE_NAME=My Store
STORE_SLUG=my-store
